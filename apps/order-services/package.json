{
  "name": "order-services",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "tsx server/standalone.ts",
    "start": "tsx server/standalone.ts",
    "setup": "tsx scripts/setup.ts",
    "demo": "tsx scripts/demo.ts",
    "confirm": "nocobase app orders confirm",
    "typecheck": "tsc --noEmit",
    "build": "tsc --outDir dist",
    "test": "vitest run",
    "format:check": "prettier --check server cli scripts database tests *.json *.ts README.md",
    "format": "prettier --write server cli scripts database tests *.json *.ts README.md"
  },
  "dependencies": {
    "@nocobase/app-cli": "1.0.0-beta.30",
    "@nocobase/app-server": "3.0.0-beta.4",
    "@nocobase/app-plugin-authentication": "2.0.0-beta.15",
    "@nocobase/app-plugin-authorization": "1.0.0-beta.33",
    "@nocobase/authorization": "1.0.0-beta.15",
    "@nocobase/db": "1.0.0-beta.23",
    "@nocobase/db-sqlite": "0.1.0-beta.6",
    "@nocobase/jobs": "0.1.0-beta.4",
    "@nocobase/service-provider": "0.0.2-beta.2",
    "better-auth": "1.7.5",
    "hono": "4.13.2",
    "zod": "4.6.5",
    "@nocobase/repository-input": "0.1.0-beta.3",
    "@nocobase/caching": "0.1.0-beta.3",
    "@nocobase/snowflake": "1.0.0-beta.4",
    "@oclif/core": "4.14.0"
  },
  "devDependencies": {
    "@nocobase/app-testing": "0.1.0-beta.6",
    "@nocobase/dev-config": "0.1.0-beta.25",
    "@types/node": "24.19.2",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "tsx": "4.21.0",
    "prettier": "3.9.10"
  },
  "prettier": "@nocobase/dev-config/prettier",
  "nocobase": {
    "templateKind": "app"
  }
}
